# GitHub token is optional for public repositories but avoids API rate limits.
GITHUB_OWNER=Murray-Assal
GITHUB_TOKEN=
# Leave blank to crawl every non-fork public repository for this owner, or provide a comma-separated allow-list.
GITHUB_REPOSITORIES=

DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_MAX_TOKENS=350
CHUNK_OVERLAP_TOKENS=40
EMBEDDING_BATCH_SIZE=32
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Optional: set to true only when a local Ollama model is available.
ANSWER_GENERATION_ENABLED=false
ANSWER_GENERATION_MODEL=llama3.2
ANSWER_GENERATION_URL=http://host.docker.internal:11434
ANSWER_GENERATION_TIMEOUT_SECONDS=30
